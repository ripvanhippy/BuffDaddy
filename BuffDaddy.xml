<Ui xmlns="http://www.blizzard.com/wow/ui/">

    <!-- Small always-visible output window. Movable by dragging with the
         mouse (unless locked via the minimap dropdown). Background is
         fully see-through by design - only the border and text render.
         No clickable elements inside except the optional Print button,
         which sits just outside the window on its right edge. -->
    <!-- FIXED SIZE, FIXED POSITION. Nothing in Lua resizes or moves
         this frame's contents anymore. To adjust anything about how
         this window looks, edit the numbers in THIS Frame block only -
         see the "Manual adjustment guide" in README.md for exactly
         which number does what.

         NOTE: this client does NOT apply x/y written as attributes
         directly on <Anchor> (e.g. <Anchor point="X" x="1" y="2"/>) -
         confirmed via in-game /script + GetPoint() dump, offsets came
         back as 0 even though the file had non-zero values, while
         <Size x=".." y=".."/> attributes DID come through correctly.
         Offsets below use the nested <Offset x=".." y=".."/> form
         instead - keep using that form for any future position edits
         in this file.

         ALSO: FontString elements do NOT support <Scripts><OnLoad>
         on this client (they're plain "regions", not full frames -
         confirmed the same way: BuffDaddyWindowTitle's own OnLoad
         never ran, GetText() came back nil, while this Frame's OnLoad
         and the Button's OnLoad elsewhere in this file do work). Any
         FontString that needs to run code on load must have that code
         moved to its parent Frame's OnLoad instead, referencing the
         FontString by name (not "this"). -->
    <Frame name="BuffDaddyWindow" toplevel="true" enableMouse="true" movable="true" parent="UIParent">
        <Size x="170" y="55"/>
        <Anchors>
            <Anchor point="CENTER" x="0" y="200"/>
        </Anchors>
        <Backdrop edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
            <BackgroundInsets left="4" right="4" top="4" bottom="4"/>
            <TileSize val="16"/>
            <EdgeSize val="16"/>
        </Backdrop>
        <Layers>
            <Layer level="OVERLAY">
                <!-- Each line below is anchored straight to
                     BuffDaddyWindow's own TOPLEFT corner with its own
                     fixed offset. None of them are anchored to each
                     other anymore - so moving one line can never drag
                     another line out of place, and each one can be
                     adjusted on its own without touching the others. -->
                <FontString name="BuffDaddyWindowTitle" inherits="GameFontNormalSmall" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeTo="BuffDaddyWindow" relativePoint="TOPLEFT">
                            <Offset x="5" y="10"/>
                        </Anchor>
                    </Anchors>
                </FontString>
                <FontString name="BuffDaddyWindowLine1" inherits="GameFontNormal" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeTo="BuffDaddyWindow" relativePoint="TOPLEFT">
                            <Offset x="5" y="-5"/>
                        </Anchor>
                    </Anchors>
                </FontString>
                <FontString name="BuffDaddyWindowLine2" inherits="GameFontNormal" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeTo="BuffDaddyWindow" relativePoint="TOPLEFT">
                            <Offset x="5" y="-17"/>
                        </Anchor>
                    </Anchors>
                </FontString>
                <FontString name="BuffDaddyWindowLine3" inherits="GameFontNormal" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeTo="BuffDaddyWindow" relativePoint="TOPLEFT">
                            <Offset x="5" y="-29"/>
                        </Anchor>
                    </Anchors>
                </FontString>
                <!-- Optional "Display players" list (line 4+), shown only when
                     BOTH the "Display players" and "Expand" dropdown/button
                     toggles are on. Filled by BuffDaddy.Output.UpdateWindow.
                     Supports embedded "\n" line breaks and |cAARRGGBB color
                     codes, same as the raid chat text. Hidden by default. -->
                <FontString name="BuffDaddyWindowPlayerList" inherits="GameFontNormal" justifyH="LEFT" hidden="true">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeTo="BuffDaddyWindow" relativePoint="TOPLEFT">
                            <Offset x="5" y="-41"/>
                        </Anchor>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Scripts>
            <OnLoad>
                BuffDaddyWindowTitle:SetText("BuffDaddy")
                BuffDaddyWindowTitle:SetTextColor(0.4, 0.8, 1)
                -- Captures whatever size is set above (including any manual
                -- resize) as the "collapsed" size the window always returns
                -- to when the Display players list is off/hidden. See
                -- BuffDaddy.Output.ResizeWindow in BuffDaddy_Output.lua.
                BuffDaddy.WindowBaseWidth = this:GetWidth()
                BuffDaddy.WindowBaseHeight = this:GetHeight()
            </OnLoad>
            <OnMouseDown>BuffDaddy.Output.OnWindowMouseDown()</OnMouseDown>
            <OnMouseUp>BuffDaddy.Output.OnWindowMouseUp()</OnMouseUp>
        </Scripts>

        <Frames>
            <!-- Optional "Expand"/"Update"/"Print" buttons, shown/hidden via
                 the minimap dropdown's "Window: show quick access buttons"
                 toggle. Top-left corner of the window, reading left to
                 right: Expand, Update, Print. When shown,
                 BuffDaddy_Output.lua shifts Line1/2/3 + the player list DOWN
                 below this row (see ApplyLineLayout in BuffDaddy_Output.lua)
                 so nothing overlaps.
                 Expand is anchored straight to the window (its Offset x="5"
                 controls where the whole row starts); Update anchors to
                 Expand's right edge, Print anchors to Update's right edge -
                 so the row is built left-to-right both in the file and on
                 screen. -->
            <Button name="BuffDaddyExpandButton" inherits="UIPanelButtonTemplate" hidden="true">
                <Size x="45" y="20"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="BuffDaddyWindow" relativePoint="TOPLEFT">
                        <Offset x="5" y="-2"/>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnLoad>this:SetText("Expand")</OnLoad>
                    <OnClick>BuffDaddy.Minimap.ToggleExpand()</OnClick>
                </Scripts>
            </Button>

            <Button name="BuffDaddyUpdateButton" inherits="UIPanelButtonTemplate" hidden="true">
                <Size x="45" y="20"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="BuffDaddyExpandButton" relativePoint="TOPRIGHT">
                        <Offset x="3" y="0"/>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnLoad>this:SetText("Update")</OnLoad>
                    <OnClick>BuffDaddy.Check.RunCheck(false)</OnClick>
                </Scripts>
            </Button>

            <Button name="BuffDaddyPrintButton" inherits="UIPanelButtonTemplate" hidden="true">
                <Size x="45" y="20"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="BuffDaddyUpdateButton" relativePoint="TOPRIGHT">
                        <Offset x="3" y="0"/>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnLoad>this:SetText("Print")</OnLoad>
                    <OnClick>BuffDaddy.Check.RunCheck(true)</OnClick>
                </Scripts>
            </Button>

            <!-- Debug button, shown/hidden via the minimap dropdown's
                 "Window: Debug button" toggle (independent of the trio
                 above). Sits ABOVE the window, anchored to its top-right
                 corner, so it never overlaps the window's own text/buttons.
                 Runs the same check as Print, but in debug mode: the
                 raid/party report AND any whispers are printed to your own
                 chat window only - nothing is sent to RAID/PARTY/WHISPER.
                 See the debug handling in BuffDaddy_Check.lua /
                 BuffDaddy_Output.lua (RunCheck, SendRaidReport,
                 SendWhispers). -->
            <Button name="BuffDaddyDebugButton" inherits="UIPanelButtonTemplate" hidden="true">
                <Size x="45" y="20"/>
                <Anchors>
                    <Anchor point="BOTTOMRIGHT" relativeTo="BuffDaddyWindow" relativePoint="TOPRIGHT">
                        <Offset x="0" y="3"/>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnLoad>this:SetText("Debug")</OnLoad>
                    <OnClick>BuffDaddy.Check.RunCheck(true, true)</OnClick>
                </Scripts>
            </Button>
        </Frames>
    </Frame>

    <!-- Minimap button.
         Left-click        -> show/hide the output window
         Shift-left-click  -> instant silent check (window only)
         Alt-left-click    -> instant check + raid chat report + whispers
         Right-click       -> opens the options dropdown
         Hover shows a tooltip explaining all of the above. -->
    <Button name="BuffDaddyMinimapButton" parent="Minimap" toplevel="true" enableMouse="true">
        <Size x="31" y="31"/>
        <Anchors>
            <Anchor point="TOPLEFT" relativeTo="Minimap" relativePoint="TOPLEFT" x="-5" y="-5"/>
        </Anchors>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture file="Interface\Icons\INV_Misc_QuestionMark">
                    <Size x="20" y="20"/>
                    <Anchors>
                        <Anchor point="CENTER" x="0" y="0"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <Scripts>
            <OnLoad>
                this:RegisterForClicks("LeftButtonUp", "RightButtonUp")
            </OnLoad>
            <OnClick>
                BuffDaddy.Minimap.OnClick(arg1)
            </OnClick>
            <OnEnter>
                BuffDaddy.Minimap.OnEnter()
            </OnEnter>
            <OnLeave>
                BuffDaddy.Minimap.OnLeave()
            </OnLeave>
        </Scripts>
    </Button>

    <!-- Options dropdown, opened by right-clicking the minimap button. -->
    <Frame name="BuffDaddyDropDown" inherits="UIDropDownMenuTemplate">
        <Scripts>
            <OnLoad>
                UIDropDownMenu_Initialize(this, BuffDaddy.Minimap.InitializeDropdown)
            </OnLoad>
        </Scripts>
    </Frame>

</Ui>
